# Add a separate site block to the existing Caddyfile after configuring DNS.
# Match WEB_PORT/API_PORT from the project's root .env; preserve existing sites.
inventory.example.com {
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}
}
